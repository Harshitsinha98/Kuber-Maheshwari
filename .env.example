# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ---------- Database (Supabase Postgres) ----------
# Pooled connection (port 6543) for the app, direct (5432) for migrations
DATABASE_URL="postgresql://postgres:password@localhost:5432/km"
DIRECT_URL="postgresql://postgres:password@localhost:5432/km"

# ---------- Auth (NextAuth + Google) ----------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma separated. These Google accounts become ADMIN / STAFF (gate scanner) on sign-in.
ADMIN_EMAILS="owner@gmail.com"
STAFF_EMAILS=""

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Email (Resend) ----------
RESEND_API_KEY=""
EMAIL_FROM="Kuber Maheshwari <tickets@your-domain.com>"
# Where new enquiries / bookings are notified
NOTIFY_EMAIL="owner@gmail.com"

# ---------- Tickets ----------
# Secret used to sign QR codes (anti-forgery). openssl rand -hex 32
TICKET_SIGNING_SECRET=""

# ---------- Social feeds (official Meta APIs, rendered in our own design — no widget watermark) ----------
# Instagram professional account, "Instagram API with Instagram Login". Long-lived token (auto-refreshed by cron).
INSTAGRAM_ACCESS_TOKEN=""
# Facebook Page id + a long-lived *Page* access token (does not expire when derived from a long-lived user token)
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_TOKEN=""

# ---------- Media uploads (Vercel Blob) ----------
BLOB_READ_WRITE_TOKEN=""

# ---------- Cron ----------
CRON_SECRET="random-string"
