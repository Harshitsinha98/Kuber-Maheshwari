# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ---------- Database (Supabase Postgres) ----------
# Pooled connection (port 6543) for the app, direct (5432) for migrations
DATABASE_URL="postgresql://postgres:password@localhost:5432/km"
DIRECT_URL="postgresql://postgres:password@localhost:5432/km"

# ---------- Auth (NextAuth + Google) ----------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma separated. These Google accounts become ADMIN / STAFF (gate scanner) on sign-in.
ADMIN_EMAILS="owner@gmail.com"
STAFF_EMAILS=""

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Email (Resend) ----------
# Only RESEND_API_KEY is required; email switches on as soon as it is set (redeploy).
RESEND_API_KEY=""
# Leave empty until a domain is verified in Resend (then e.g. "Kuber Maheshwari <tickets@your-domain.com>").
# Empty = Resend testing sender, which only delivers to your own Resend account email.
EMAIL_FROM=""
# Where booking/enquiry alerts go. Empty = first address in ADMIN_EMAILS.
NOTIFY_EMAIL=""

# ---------- Tickets ----------
# Secret used to sign QR codes (anti-forgery). openssl rand -hex 32
TICKET_SIGNING_SECRET=""

# ---------- Social feeds (official Meta APIs, rendered in our own design — no widget watermark) ----------
# Instagram professional account, "Instagram API with Instagram Login". Long-lived token (auto-refreshed by cron).
INSTAGRAM_ACCESS_TOKEN=""
# Facebook Page id + a long-lived *Page* access token (does not expire when derived from a long-lived user token)
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_TOKEN=""

# ---------- Wallet passes (optional; buttons appear automatically when set) ----------
# Google Wallet: issuer id from pay.google.com/business/console + the service-account JSON key (paste whole JSON or base64)
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT=""
# Apple Wallet (Apple Developer Program): Pass Type ID, Team ID, and PEM certs (paste PEM or base64 of PEM)
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT=""
APPLE_PASS_KEY=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT=""

# ---------- Media uploads (Vercel Blob) ----------
BLOB_READ_WRITE_TOKEN=""

# ---------- Cron ----------
CRON_SECRET="random-string"
